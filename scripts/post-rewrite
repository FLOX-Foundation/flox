#!/bin/sh
#
# scripts/post-rewrite — keep the bundled MCP index correct across a rebase.
#
# scripts/pre-commit rebuilds mcp/flox_mcp/data/docs.fts.sqlite whenever the
# docs change, so a commit is always self-consistent. A rebase is where that
# breaks: .gitattributes gives the file `merge=ours`, which during a rebase
# means the UPSTREAM copy wins -- no conflict, but the index now describes
# main's docs rather than the rebased branch's. CI's `sync_mcp_data.py --check`
# then fails, which is exactly what happened four times by hand on 2026-09-19.
#
# So: after a rebase, rebuild the index and fold it into the commit it belongs
# to. Nothing to do when it did not change.
#
# Install (one-time, per checkout) -- the same two lines the pre-commit hook
# needs:
#
#     git config core.hooksPath scripts
#     git config merge.ours.driver true
#
# Guarded to rebase: git also calls this after `commit --amend`, and amending
# there would recurse.

[ "$1" = "rebase" ] || exit 0

# No guard against a stopped rebase is needed, and the obvious one is wrong:
# git calls this hook BEFORE it cleans up the rebase state directory, so a
# check for that directory fires on every successful rebase and does nothing
# on a failed one. Verified both ways -- a rebase that stops for a conflict
# never reaches this hook at all; it runs only once the rebase has finished
# replaying every commit.

INDEX="mcp/flox_mcp/data/docs.fts.sqlite"
[ -f "$INDEX" ] || exit 0

python3 scripts/sync_mcp_data.py > /dev/null 2>&1 || exit 0

git diff --quiet -- "$INDEX" && exit 0

echo "[post-rewrite] the rebase left $INDEX describing the old base; rebuilt and folded in"
git add -- "$INDEX"
git commit --amend --no-edit --no-verify > /dev/null
