# flox/order_type_codes.codon -- the one shared order-type string<->code
# table for Codon, mirroring include/flox/capi/order_type_names.hpp.
#
# This is the flox::OrderType wire-code space (LIMIT=0, MARKET=1,
# STOP_MARKET=2, STOP_LIMIT=3, TAKE_PROFIT_MARKET=4, TAKE_PROFIT_LIMIT=5,
# TRAILING_STOP=6, ICEBERG=7). It is the space every submit_order[_ex]
# entry point on flox_simulated_executor takes. It is NOT the
# FLOX_SIGNAL_TYPE_* space (see include/flox/capi/flox_capi.h), which only
# appears on FloxSignal.order_type and swaps LIMIT/MARKET relative to this
# one.
#
# Both `tools.SimulatedExecutor` and `backtest.SimulatedExecutor` call this
# instead of keeping their own copy of the mapping -- a private copy in
# `tools.codon` (raw int, default 0 = LIMIT) is what caused the Codon
# binding's order-type mismatch.


def order_type_code_from_str(order_type: str) -> u8:
    """Encode an order-type string into flox::OrderType wire codes."""
    if order_type == "limit":
        return u8(0)
    if order_type == "market":
        return u8(1)
    if order_type == "stop_market":
        return u8(2)
    if order_type == "stop_limit":
        return u8(3)
    if order_type == "take_profit_market":
        return u8(4)
    if order_type == "take_profit_limit":
        return u8(5)
    if order_type == "trailing_stop":
        return u8(6)
    if order_type == "iceberg":
        return u8(7)
    raise ValueError("unknown order_type: " + order_type)
