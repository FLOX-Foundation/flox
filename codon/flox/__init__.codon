# Flox Codon Module
# High-performance trading strategy framework compiled to native code.
#
# Usage:
#   from flox.strategy import Strategy
#   from flox.types import Price, Quantity
#   from flox.indicators import ema, sma
#   from flox.targets import future_return  # research-only labels

# The C ABI handshake: importing flox.abi runs it, and a binding that
# loaded against the wrong library exits before it can hand a strategy a
# wrong number. Every module below that declares a `from C import` pulls
# it in too, so importing a submodule directly runs it as well.
from flox.abi import check_abi_version
from flox.types import *
from flox.context import *
from flox.strategy import *
from flox.indicators import *
from flox.tools import *
# Backtest helpers are opt-in to avoid coupling strategy builds to the
# full backtest surface. Import explicitly:
#   from flox.backtest import SimulatedExecutor, BacktestResult, BacktestStats
#
# Engine + SignalBuilder for batch backtesting from CSV:
#   from flox.engine import Engine, SignalBuilder
