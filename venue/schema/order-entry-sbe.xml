<?xml version="1.0" encoding="UTF-8"?>
<!--
  Flox venue order-entry SBE schema.

  Source of truth for flox-venue/sbe_order_entry_codec.h. Same SBE contract as
  the market-data schema (venue/schema/md-sbe.xml): a fixed messageHeader
  composite (blockLength, templateId, schemaId, version) precedes every message,
  all encodings are little-endian, and a reader uses blockLength to skip trailing
  fields a newer sender added. One template per message type; each carries only
  the fields that type needs.

  Direction is by templateId: inbound (client -> venue) uses ids 1..3, outbound
  exec reports (venue -> client) use ids 10..18. Real crypto venues run binary
  order entry over SBE (Deribit Binary Order Entry, Binance SBE); this is the
  venue's own SBE order-entry schema, replacing a homegrown record that was
  misleadingly named "OUCH".

  Prices and quantities are the engine's fixed-point raw values (scale 1e-8).
  Enum byte fields (side, ordType, tif, stp, peg, cancel/reject reason) carry
  the engine enum's underlying uint8 value.

  Version 1 (session-layer recovery):
  - Every OUTBOUND template gained a trailing `seq` field (uint64,
    sinceVersion="1"): the per-session monotonic execution-report sequence
    number. Appended to the END of each root block, so a version-0 reader
    skips it via the header blockLength — the SBE-sanctioned extension path
    (no wrapper template, no re-layout).
  - New inbound session verbs: ResendRequest (4) replays reports with
    seq >= fromSeq from the venue's per-session log; AccountSnapshotRequest
    (5) requests open orders (a series of Accepted frames) + position,
    terminated by SnapshotEnd (20). SnapshotRequired (19) answers a
    ResendRequest whose fromSeq is older than the retained log.
  These verbs are handled at the gateway session layer and never reach
  matching.

  Version 2:
  - SnapshotEnd gained a trailing `lastSeq` field (uint64, sinceVersion="2"):
    the last assigned outbound seq of the account's exec-report stream at
    snapshot time, so the client resumes gap detection from the exact point.
    Snapshot frames themselves stay unsequenced and are never in the resend
    log.
  - New inbound session verb SetSessionConfig (6): per-session
    cancel-on-disconnect negotiation. Fire-and-forget — the update takes
    effect immediately, there is no reply frame (the effect is observable: a
    later disconnect sweeps or keeps the session's orders).
  - New outbound BalanceUpdate (21): balance change on a sequenced
    Deposit/Withdraw, carrying the post-event available/reserved of the
    touched (account, asset). reason: 0=Deposit, 1=Withdraw,
    2=WithdrawRejected (insufficient available; balances unchanged).

  Version 4: the five templates that report on an ORDER (Accepted, Executed,
  Canceled, Rejected, Replaced) gained a trailing `clOrdId` field (OrderId,
  sinceVersion="4"): the identifier the submitter gave the order, 0 when it
  gave none. A submitter reconciles reports against the name it chose, and on
  a reject there may be no other name to reconcile against. Appended after
  `seq`, so a version-3 reader skips it via blockLength.

  Version 6: FillHeld (17) gained a trailing `takerSide` field (EnumU8,
  sinceVersion="6"): the side of the aggressor whose hit is being held. A
  client had to rebuild it by remembering the side of every order it placed
  and matching the hold back to one of them; the venue has had it all along.
  Appended after `seq`, so a version-5 reader skips it via blockLength.

  Version 8: new inbound QuoteLadder (7), a market maker's whole set of
  levels on one symbol in one message, replacing the prior set. The engine
  command of the same name (venue/include/flox-venue/messages.h) is exactly
  the K Quotes it stands for, so this is the order-entry wire for what a
  maker previously had to send as K separate replaces. The levels are a FIXED
  block of 8 slots with a `levels` count rather than an SBE repeating group:
  this codec has no var-length support, and inventing it for one message
  would change every decoder's framing. Slots past `levels` carry zero sizes,
  which is how a shorter ladder takes down the rungs it stopped naming.
  Additive, like every version before it: a version-7 reader never sees
  template 7 and is unaffected.

  Version 7: FillHeld (17) and FillRejected (18) gained a trailing `clOrdId`
  field (OrderId, sinceVersion="7"): the identifier the TAKER gave its order,
  0 when it gave none. A hold's own id names the hold, not the order that
  caused it, so a submitter whose order was split into venue-level children
  had to keep a 37 to 11 map of its own just to recognise a hold or a reject
  on one of them. Appended after `seq` on FillRejected, and after `takerSide`
  on FillHeld, so a version-6 reader skips it via blockLength on both.
-->
<sbe:messageSchema xmlns:sbe="http://fixprotocol.io/2016/sbe"
                   package="flox.venue.oe"
                   id="92"
                   version="8"
                   semanticVersion="1.0"
                   description="Flox venue order entry + execution reports"
                   byteOrder="littleEndian">
  <types>
    <composite name="messageHeader" description="SBE message header">
      <type name="blockLength" primitiveType="uint16"/>
      <type name="templateId"  primitiveType="uint16"/>
      <type name="schemaId"    primitiveType="uint16"/>
      <type name="version"     primitiveType="uint16"/>
    </composite>
    <type name="OrderId"  primitiveType="uint64"/>
    <type name="Symbol"   primitiveType="uint32"/>
    <type name="Account"  primitiveType="uint64"/>
    <type name="PriceRaw" primitiveType="int64"/>
    <type name="QtyRaw"   primitiveType="int64"/>
    <type name="Flag"     primitiveType="uint8"/>   <!-- boolean 0/1 -->
    <type name="EnumU8"   primitiveType="uint8"/>   <!-- engine enum underlying value -->
    <type name="Nanos"    primitiveType="int64"/>
    <type name="SeqNum"   primitiveType="uint64"/>  <!-- per-session exec-report sequence -->
    <type name="NoteText" primitiveType="char" length="32"/>  <!-- NUL-padded operator note -->
    <!-- 8 ladder rungs, each bidPrice/bidQty/askPrice/askQty as int64 raw:
         a fixed 256-byte block, not a repeating group (see the version-8
         note above). -->
    <type name="LadderRungs" primitiveType="int64" length="32"/>
  </types>

  <!-- ============ inbound: client -> venue ============ -->

  <!-- Enter a new order. Carries every NewOrder field the wire needs, including
       derivatives / MM / advanced-order fields (reduceOnly must survive: an
       order that loses it would OPEN a position). -->
  <sbe:message name="EnterOrder" id="1">
    <field name="orderId"        id="1"  type="OrderId"/>
    <field name="symbol"         id="2"  type="Symbol"/>
    <field name="side"           id="3"  type="EnumU8"/>
    <field name="ordType"        id="4"  type="EnumU8"/>
    <field name="tif"            id="5"  type="EnumU8"/>
    <field name="postOnly"       id="6"  type="Flag"/>
    <field name="stp"            id="7"  type="EnumU8"/>
    <field name="price"          id="8"  type="PriceRaw"/>
    <field name="qty"            id="9"  type="QtyRaw"/>
    <field name="visibleQty"     id="10" type="QtyRaw"/>
    <field name="triggerPrice"   id="11" type="PriceRaw"/>
    <field name="trailingOffset" id="12" type="PriceRaw"/>
    <field name="account"        id="13" type="Account"/>
    <field name="clientOrderId"  id="14" type="OrderId"/>
    <field name="reduceOnly"     id="15" type="Flag"/>
    <field name="lastLook"       id="16" type="Flag"/>
    <field name="peg"            id="17" type="EnumU8"/>
    <field name="expiryNs"       id="18" type="Nanos"/>
    <field name="ocoGroup"       id="19" type="OrderId"/>
    <field name="pegOffsetRaw"   id="20" type="PriceRaw"/>
  </sbe:message>

  <!-- Cancel a resting order by id. -->
  <sbe:message name="CancelOrder" id="2">
    <field name="orderId" id="1" type="OrderId"/>
    <field name="symbol"  id="2" type="Symbol"/>
    <field name="account" id="3" type="Account"/>
  </sbe:message>

  <!-- Cancel/replace: new price and quantity. -->
  <sbe:message name="ReplaceOrder" id="3">
    <field name="orderId"  id="1" type="OrderId"/>
    <field name="symbol"   id="2" type="Symbol"/>
    <field name="newPrice" id="3" type="PriceRaw"/>
    <field name="newQty"   id="4" type="QtyRaw"/>
    <field name="account"  id="5" type="Account"/>
  </sbe:message>

  <!-- Session verb: replay exec reports with seq >= fromSeq from the venue's
       per-session resend log (reconnect gap-fill). Answered by the replayed
       frames, or by SnapshotRequired when fromSeq is older than the log. -->
  <sbe:message name="ResendRequest" id="4" sinceVersion="1">
    <field name="fromSeq" id="1" type="SeqNum" sinceVersion="1"/>
  </sbe:message>

  <!-- Session verb: request the session account's open orders + position.
       Carries no fields — the authenticated session IS the account. Answered
       by a series of Accepted frames (restingOnBook=0 for pending stops)
       terminated by SnapshotEnd. -->
  <sbe:message name="AccountSnapshotRequest" id="5" sinceVersion="1"/>

  <!-- Session verb: per-session config negotiation (today: cancel-on-
       disconnect). Fire-and-forget, applied at the gateway; no reply frame. -->
  <sbe:message name="SetSessionConfig" id="6" sinceVersion="2">
    <field name="codEnabled" id="1" type="Flag" sinceVersion="2"/>
  </sbe:message>

  <!-- A market maker's whole set of levels on one symbol, replacing the prior
       set in one message (FIX calls the shape a mass quote). Level i posts
       under orderId bidIdBase+i / askIdBase+i, so the ladder owns a block of
       8 ids a side and can name the levels a shorter ladder drops. Slots past
       `levels` are ignored on the wire and treated as zero-sized rungs, which
       takes those levels down. Every flag applies to every leg, exactly as a
       single two-sided quote's flags apply to both of its legs. -->
  <sbe:message name="QuoteLadder" id="7" sinceVersion="8">
    <field name="account"     id="1"  type="Account"  sinceVersion="8"/>
    <field name="clOrdId"     id="2"  type="OrderId"  sinceVersion="8"/>
    <field name="expiryNs"    id="3"  type="Nanos"    sinceVersion="8"/>
    <field name="visibleQty"  id="4"  type="QtyRaw"   sinceVersion="8"/>
    <field name="bidIdBase"   id="5"  type="OrderId"  sinceVersion="8"/>
    <field name="askIdBase"   id="6"  type="OrderId"  sinceVersion="8"/>
    <field name="symbol"      id="7"  type="Symbol"   sinceVersion="8"/>
    <field name="levels"      id="8"  type="Flag"     sinceVersion="8"/>
    <field name="stp"         id="9"  type="EnumU8"   sinceVersion="8"/>
    <field name="lastLook"    id="10" type="Flag"     sinceVersion="8"/>
    <field name="postOnly"    id="11" type="Flag"     sinceVersion="8"/>
    <field name="reduceOnly"  id="12" type="Flag"     sinceVersion="8"/>
    <field name="tif"         id="13" type="EnumU8"   sinceVersion="8"/>
    <field name="rungs"       id="14" type="LadderRungs" sinceVersion="8"/>
  </sbe:message>

  <!-- ============ outbound: venue -> client (execution reports) ============ -->

  <!-- Order accepted / working. -->
  <sbe:message name="Accepted" id="10">
    <field name="orderId"      id="1" type="OrderId"/>
    <field name="symbol"       id="2" type="Symbol"/>
    <field name="side"         id="3" type="EnumU8"/>
    <field name="price"        id="4" type="PriceRaw"/>
    <field name="leavesQty"    id="5" type="QtyRaw"/>
    <field name="restingOnBook" id="6" type="Flag"/>
    <field name="seq"     id="7" type="SeqNum" sinceVersion="1"/>
    <field name="clOrdId"  id="8" type="OrderId" sinceVersion="4"/>
  </sbe:message>

  <!-- Order (partially) executed. -->
  <sbe:message name="Executed" id="11">
    <field name="orderId"   id="1" type="OrderId"/>
    <field name="symbol"    id="2" type="Symbol"/>
    <field name="lastQty"   id="3" type="QtyRaw"/>
    <field name="lastPx"    id="4" type="PriceRaw"/>
    <field name="leavesQty" id="5" type="QtyRaw"/>
    <field name="aggressor" id="6" type="Flag"/>
    <field name="complete"  id="7" type="Flag"/>
    <field name="seq"     id="8" type="SeqNum" sinceVersion="1"/>
    <field name="clOrdId"  id="9" type="OrderId" sinceVersion="4"/>
  </sbe:message>

  <!-- Trade print. -->
  <sbe:message name="Trade" id="12">
    <field name="tradeId"   id="1" type="OrderId"/>
    <field name="symbol"    id="2" type="Symbol"/>
    <field name="price"     id="3" type="PriceRaw"/>
    <field name="qty"       id="4" type="QtyRaw"/>
    <field name="makerId"   id="5" type="OrderId"/>
    <field name="takerId"   id="6" type="OrderId"/>
    <field name="takerSide" id="7" type="EnumU8"/>
    <field name="seq"     id="8" type="SeqNum" sinceVersion="1"/>
  </sbe:message>

  <!-- Order canceled (reason = CancelReason underlying value). -->
  <sbe:message name="Canceled" id="13">
    <field name="orderId" id="1" type="OrderId"/>
    <field name="symbol"  id="2" type="Symbol"/>
    <field name="reason"  id="3" type="EnumU8"/>
    <field name="seq"     id="4" type="SeqNum" sinceVersion="1"/>
    <field name="clOrdId"  id="5" type="OrderId" sinceVersion="4"/>
  </sbe:message>

  <!-- Order rejected (reason = RejectReason underlying value). -->
  <sbe:message name="Rejected" id="14">
    <field name="orderId" id="1" type="OrderId"/>
    <field name="symbol"  id="2" type="Symbol"/>
    <field name="reason"  id="3" type="EnumU8"/>
    <field name="seq"     id="4" type="SeqNum" sinceVersion="1"/>
    <field name="clOrdId"  id="5" type="OrderId" sinceVersion="4"/>
  </sbe:message>

  <!-- Order replaced (priorityKept = kept time priority in place). -->
  <sbe:message name="Replaced" id="15">
    <field name="orderId"      id="1" type="OrderId"/>
    <field name="symbol"       id="2" type="Symbol"/>
    <field name="price"        id="3" type="PriceRaw"/>
    <field name="leavesQty"    id="4" type="QtyRaw"/>
    <field name="priorityKept" id="5" type="Flag"/>
    <field name="seq"     id="6" type="SeqNum" sinceVersion="1"/>
    <field name="clOrdId"  id="7" type="OrderId" sinceVersion="4"/>
  </sbe:message>

  <!-- Conditional order triggered (refPrice = reference that crossed). -->
  <sbe:message name="Triggered" id="16">
    <field name="orderId"  id="1" type="OrderId"/>
    <field name="symbol"   id="2" type="Symbol"/>
    <field name="refPrice" id="3" type="PriceRaw"/>
    <field name="seq"     id="4" type="SeqNum" sinceVersion="1"/>
  </sbe:message>

  <!-- Last look: a fill is held pending the maker's decision. heldId is the
       handle a LastLookDecision answers with. makerDisplayAfter is the maker's
       displayed remaining after the held qty left the book (public feed sync).
       takerSide is the aggressor's side; the maker's is the opposite one.
       clOrdId is the identifier the TAKER gave its order, 0 when it gave
       none. -->
  <sbe:message name="FillHeld" id="17">
    <field name="heldId"            id="1" type="OrderId"/>
    <field name="symbol"            id="2" type="Symbol"/>
    <field name="makerId"           id="3" type="OrderId"/>
    <field name="takerId"           id="4" type="OrderId"/>
    <field name="price"             id="5" type="PriceRaw"/>
    <field name="qty"               id="6" type="QtyRaw"/>
    <field name="makerDisplayAfter" id="7" type="QtyRaw"/>
    <field name="seq"       id="8" type="SeqNum" sinceVersion="1"/>
    <field name="takerSide" id="9" type="EnumU8" sinceVersion="6"/>
    <field name="clOrdId"   id="10" type="OrderId" sinceVersion="7"/>
  </sbe:message>

  <!-- Last look: the held fill was rejected (or timed out). Carries the
       counterparty order, price and size so the taker has a usable report.
       clOrdId is the identifier the TAKER gave its order, 0 when it gave
       none. -->
  <sbe:message name="FillRejected" id="18">
    <field name="heldId"  id="1" type="OrderId"/>
    <field name="symbol"  id="2" type="Symbol"/>
    <field name="takerId" id="3" type="OrderId"/>
    <field name="makerId" id="4" type="OrderId"/>
    <field name="price"   id="5" type="PriceRaw"/>
    <field name="qty"     id="6" type="QtyRaw"/>
    <field name="seq"     id="7" type="SeqNum" sinceVersion="1"/>
    <field name="clOrdId" id="8" type="OrderId" sinceVersion="7"/>
  </sbe:message>

  <!-- Session layer: the requested resend fromSeq is older than the retained
       log — the client must reconcile via AccountSnapshotRequest instead.
       lastSeq = the venue's current per-session sequence. -->
  <sbe:message name="SnapshotRequired" id="19" sinceVersion="1">
    <field name="lastSeq" id="1" type="SeqNum" sinceVersion="1"/>
  </sbe:message>

  <!-- Session layer: terminates an account snapshot reply. lastSeq = the
       stream's last assigned outbound seq at snapshot time (snapshot frames
       are unsequenced and never in the resend log); the client resumes gap
       detection from it. -->
  <sbe:message name="SnapshotEnd" id="20" sinceVersion="1">
    <field name="account"          id="1" type="Account" sinceVersion="1"/>
    <field name="positionQtyRaw"   id="2" type="QtyRaw" sinceVersion="1"/>
    <field name="positionEntryRaw" id="3" type="PriceRaw" sinceVersion="1"/>
    <field name="openOrders"       id="4" type="uint32" sinceVersion="1"/>
    <field name="lastSeq"          id="5" type="SeqNum" sinceVersion="2"/>
  </sbe:message>

  <!-- Balance change on a sequenced Deposit/Withdraw: post-event available/
       reserved of the touched (account, asset). reason: 0=Deposit,
       1=Withdraw, 2=WithdrawRejected (insufficient available; unchanged). -->
  <sbe:message name="BalanceUpdate" id="21" sinceVersion="2">
    <field name="account"      id="1" type="Account" sinceVersion="2"/>
    <field name="asset"        id="2" type="uint16" sinceVersion="2"/>
    <field name="availableRaw" id="3" type="QtyRaw" sinceVersion="2"/>
    <field name="reservedRaw"  id="4" type="QtyRaw" sinceVersion="2"/>
    <field name="reason"       id="5" type="EnumU8" sinceVersion="2"/>
    <field name="seq"          id="6" type="SeqNum" sinceVersion="2"/>
  </sbe:message>

  <!-- A cancel or cancel/replace that was refused. Distinct from Rejected
       because it answers a different request: FIX 4.4 maps it to 35=9, not to
       an execution report, and wasReplace is what says which of the two the
       counterparty sent. -->
  <sbe:message name="CancelRejected" id="22" sinceVersion="3">
    <field name="orderId"    id="1" type="OrderId"/>
    <field name="symbol"     id="2" type="Symbol"/>
    <field name="reason"     id="3" type="EnumU8"/>
    <field name="wasReplace" id="4" type="Flag"/>
    <field name="seq"        id="5" type="SeqNum"/>
  </sbe:message>

  <!-- An operator corrected this account's position. Not a fill: no order, no
       price, no fee. The owner of the account is told because its position
       changed under it, and a client that reconciles against the venue would
       otherwise see a jump with nothing to explain it. -->
  <sbe:message name="PositionAdjusted" id="23" sinceVersion="5">
    <field name="account"       id="1" type="Account"/>
    <field name="symbol"        id="2" type="Symbol"/>
    <field name="qtyDeltaRaw"   id="3" type="QtyRaw"/>
    <field name="qtyAfterRaw"   id="4" type="QtyRaw"/>
    <field name="entryAfterRaw" id="5" type="PriceRaw"/>
    <field name="reason"        id="6" type="EnumU8"/>
    <field name="seq"           id="7" type="SeqNum"/>
    <!-- Fixed 32 bytes, NUL-padded, not a var-length field: this codec has no
         var-length support, and inventing it for one note would change every
         decoder's framing for a string. -->
    <field name="note"          id="8" type="NoteText"/>
  </sbe:message>
</sbe:messageSchema>
